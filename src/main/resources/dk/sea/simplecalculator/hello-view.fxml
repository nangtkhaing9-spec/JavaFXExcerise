<VBox alignment="CENTER" prefHeight="389.0" prefWidth="242.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.sea.simplecalculator.HelloController">
