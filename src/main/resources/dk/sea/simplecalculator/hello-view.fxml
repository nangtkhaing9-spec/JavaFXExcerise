         </children>
      </HBox>
      <HBox prefHeight="25.0" prefWidth="300.0">
         <children>
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#onBtnClearClicked" prefHeight="26.0" prefWidth="50.0" text="C">
